# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/package-lock.json

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# electron packaging output
/release

# misc
.DS_Store
*.pem

# editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite database
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm

# brag video output (renders, plans, compositions, work files)
/brag-output*/

# agent tooling (installed skills and local Claude Code config)
/.agents/
/.claude/
/skills-lock.json
